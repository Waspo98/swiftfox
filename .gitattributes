# Normalize line endings across Windows, WSL, and Docker/Linux toolchains
* text=auto eol=lf

# Windows scripts expect CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell & Gradle wrapper scripts must stay LF
gradlew text eol=lf
*.sh text eol=lf

# Explicit binary assets
*.so binary
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
